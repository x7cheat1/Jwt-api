{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/token",
      "dest": "index.py"
    },
    {
      "src": "/process",
      "dest": "index.py"
    },
    {
      "src": "/(.*)",
      "dest": "index.html"
    }
  ]
}
